{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MarbleOS",
  "mainBinaryName": "MarbleOS",
  "version": "../package.json",
  "identifier": "io.github.fisbal.marbleos",
  "build": {
    "frontendDist": "../android/app/src/main/assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarbleOS",
        "zoomHotkeysEnabled": true,
        "width": 560,
        "height": 920,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "Martin Balla",
    "shortDescription": "MarbleOS",
    "longDescription": "A 3D marble shooter by Martin B: 24 levels in 12 carved-stone worlds. Works offline, French and English.",
    "category": "Game",
    "copyright": "Martin Balla",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_BY_CI_FROM_THE_TAURI_SIGNING_PUBLIC_KEY_SECRET",
      "endpoints": ["https://github.com/fisbal/MarbleOS/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
